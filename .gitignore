### --- ROOT LEVEL IGNORE RULES ---

# Git metadata (defensive)
.git/

# OS-specific junk
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Build output
dist/
*.zip

# Generated content script (source of truth is src/content/*.js)
content.js

# Screenshots
ss-*.png

# Claude Code
.claude/
CLAUDE.md

# VS Code / Visual Studio / IDE
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Local workspace / caches
*.cache
*.ide
*.ncb
*.dbmdl
*.VC.db
*.VC.VC.opendb
*.opendb
*.vsidx
*.db
*.sdf

# Build artifacts (Node, .NET, Avalonia, MonoGame)
bin/
obj/
dist/
out/
build/
temp/
tmp/

# .NET / C# compiled stuff
*.dll
*.exe
*.pdb
*.mdb
*.appx
*.appxupload
*.msix
*.msixupload
*.msixbundle
*.appxbundle
*.log

# MonoGame / Avalonia intermediates
client/**/Content/bin/
client/**/Content/obj/
client/**/bin/
client/**/obj/
rc/**/bin/
rc/**/obj/

# Node.js deps (we DO commit package.json + package-lock.json)
server/node_modules/

# TypeScript build info
*.tsbuildinfo

# Generated source maps & declaration maps
*.js.map
*.d.ts.map

# Environment / secrets
.env
.env.*
*.env

# BUT: keep example templates in git
!server/.env.example

# Python venv leftovers
venv/
__pycache__/
*.pyc

# Runtime / temp data / world state / logs
logs/
cache/
*.pid
*.seed
*.sqlite
*.db
*.sav
*.dump
*.bak
*.old
*.tmp
*.temp

# Socratic session state
.state/
