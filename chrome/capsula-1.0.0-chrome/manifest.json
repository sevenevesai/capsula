{
  "manifest_version": 3,
  "name": "Capsula",
  "short_name": "Capsula",
  "version": "1.0.0",
  "description": "Save & export your AI conversations.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "homepage_url": "https://seveneves.ai/capsula",
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}