{
  "manifest_version": 2,
  "name": "Claude Export POC",
  "version": "0.1.0",
  "description": "Proof of concept for Claude.ai conversation export",
  "author": "Mark T. Short (seveneves.ai)",

  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "js": [
        "claude-platform-poc.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "clipboardWrite"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "claude-poc@seveneves.ai",
      "strict_min_version": "109.0"
    }
  }
}
